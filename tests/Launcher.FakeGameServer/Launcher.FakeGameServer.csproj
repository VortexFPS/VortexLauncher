<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for the Vortex Arena dedicated server, so the supervisor can be tested with no Godot
       in CI (plan §10). It takes the arguments SupervisedInstance.StartAsync passes, answers getinfo
       and DarkPlaces srcon on the port it was given, writes eventlog lines to stdout, and can be
       scripted to crash, hang or ignore its stdin.

       References Launcher.Core for Md4 and nothing else. The rest of the wire format is written out
       again here on purpose: a fixture that shares a codec with the code under test agrees with that
       codec's bugs, and this one exists to disagree. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Launcher.FakeGameServer</RootNamespace>
    <AssemblyName>Launcher.FakeGameServer</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- It lives under tests/ but it is an executable fixture, not a test assembly. Saying so keeps
         `dotnet test` from hunting for a test adapter inside it. -->
    <IsTestProject>false</IsTestProject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>
</Project>
