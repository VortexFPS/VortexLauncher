# Normalise text by default so a Windows and a Linux checkout agree.
* text=auto

# Shell scripts run on the Linux CI runners — a CRLF shebang breaks them
# ("bad interpreter: /bin/sh^M"). Force LF regardless of core.autocrlf.
*.sh    text eol=lf

# Windows-only launchers stay CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
