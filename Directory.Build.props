<Project>
  <!-- Shared MSBuild properties for the launcher solution.

       These are NOT optional and they are NOT stylistic. This code was written inside the game repo,
       where it inherited VortexArena's root Directory.Build.props; extracting `launcher/` into its own
       repo left it with nothing above it, and the build fails outright without these:

         ImplicitUsings  — Task, HttpClient, Dictionary<,>, IProgress<>, CancellationToken and
                           STAThreadAttribute are all used with no explicit `using`. Dropping this
                           produced ~20 CS0246 "type or namespace not found" errors, and then a
                           cascade of MVVMTK0007/MVVMTK0016 from the CommunityToolkit source
                           generator, because its partial methods could not bind against code that
                           no longer compiled. The generator errors are the loud symptom; the missing
                           usings are the cause.
         Nullable        — every `string?` / `T?` annotation in Core/ becomes a CS8632 warning
                           ("annotation ... outside a '#nullable' context") and, worse, stops being
                           CHECKED. That half is quiet: the code keeps compiling and the null-safety
                           the annotations claim silently stops being verified.

       Deliberately NOT carried over from the game's props: the Debug `<Optimize>true</Optimize>`
       block (it exists for the 72 Hz sim's hot loops and only costs step-debugging fidelity here) and
       the XG_BOTPLAYER gate (game-only, and a launcher has no business defining it). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned to the language version that ships with the net8.0 above, NOT `latest`.

         `latest` means the language is whatever the newest SDK on the machine implements, which is
         a different language on CI than on a dev box and changes under you on a runner-image bump.
         That is not hypothetical here: the hosted images gained a .NET 10 SDK, `dotnet` picks the
         highest installed SDK when there is no global.json (setup-dotnet's `dotnet-version: 8.0.x`
         only guarantees 8.0.x is *present*), and C# 14's first-class span conversions re-bound
         `byte[].Reverse()` in Signing/Minisign.cs from Enumerable.Reverse to the void-returning
         MemoryExtensions.Reverse. Three commits landed on main compiling locally on SDK 9 and
         failing CI on SDK 10 with CS0023.

         The stronger fix is a global.json pinning the SDK itself, which also pins Roslyn and the
         analyzers; it is not here only because it would require every dev box to install the 8.0
         SDK specifically. Worth doing when that is acceptable. -->
    <LangVersion>12.0</LangVersion>
    <!-- Release version. CI overrides the patch per build (see .github/workflows/release.yml);
         bump the major/minor here by hand. Without this every assembly reports 1.0.0.0, which
         LauncherConfig.UserAgent and RunnerLink both put on the wire as fact. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
